{
  "$defs": {
    "CicloAgregado": {
      "additionalProperties": false,
      "properties": {
        "ano": {
          "title": "Ano",
          "type": "integer"
        },
        "data_eleicao": {
          "format": "date",
          "title": "Data Eleicao",
          "type": "string"
        },
        "notas": {
          "items": {
            "type": "string"
          },
          "title": "Notas",
          "type": "array"
        },
        "pedidos": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Boletins por correspondência pedidos até ao mesmo dia, quando a fonte os tem.",
          "title": "Pedidos"
        },
        "tipo": {
          "enum": [
            "intercalar",
            "presidencial"
          ],
          "title": "Tipo",
          "type": "string"
        },
        "votos": {
          "description": "Final nos anos anteriores; acumulado até ``dias_antes`` em 2026.",
          "minimum": 0,
          "title": "Votos",
          "type": "integer"
        },
        "votos_mesmo_dia": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Votos até ao mesmo dia do ciclo que o ano atual (só nos anos de comparação).",
          "title": "Votos Mesmo Dia"
        }
      },
      "required": [
        "ano",
        "tipo",
        "data_eleicao",
        "votos",
        "votos_mesmo_dia",
        "pedidos",
        "notas"
      ],
      "title": "CicloAgregado",
      "type": "object"
    },
    "CicloVotoAntecipado": {
      "additionalProperties": false,
      "description": "Uma eleição comparável (2026 ou um ano de referência).",
      "properties": {
        "ano": {
          "title": "Ano",
          "type": "integer"
        },
        "ano_referencia_historico": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Eleição usada para classificar o histórico de voto de cada eleitor.",
          "title": "Ano Referencia Historico"
        },
        "data_eleicao": {
          "format": "date",
          "title": "Data Eleicao",
          "type": "string"
        },
        "fim_presencial_dias_antes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fim Presencial Dias Antes"
        },
        "inicio_presencial_dias_antes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Primeiro dia do voto antecipado presencial, em dias antes da eleição.",
          "title": "Inicio Presencial Dias Antes"
        },
        "notas": {
          "description": "Diferenças de regras ou de contexto que afetam a comparação.",
          "items": {
            "type": "string"
          },
          "title": "Notas",
          "type": "array"
        },
        "registados": {
          "minimum": 0,
          "title": "Registados",
          "type": "integer"
        },
        "tipo": {
          "enum": [
            "intercalar",
            "presidencial"
          ],
          "title": "Tipo",
          "type": "string"
        },
        "votos_antecipados": {
          "description": "Total de votos antecipados: final nos anos anteriores, acumulado até agora em 2026.",
          "minimum": 0,
          "title": "Votos Antecipados",
          "type": "integer"
        }
      },
      "required": [
        "ano",
        "tipo",
        "data_eleicao",
        "inicio_presencial_dias_antes",
        "fim_presencial_dias_antes",
        "ano_referencia_historico",
        "registados",
        "votos_antecipados",
        "notas"
      ],
      "title": "CicloVotoAntecipado",
      "type": "object"
    },
