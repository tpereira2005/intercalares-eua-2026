    "Fonte": {
      "additionalProperties": false,
      "description": "Origem de um conjunto de dados, citada em cada número publicado.",
      "properties": {
        "licenca": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Licença ou termos de utilização, quando conhecidos.",
          "title": "Licenca"
        },
        "nome": {
          "description": "Nome legível da fonte, por exemplo \"North Carolina State Board of Elections\".",
          "minLength": 1,
          "title": "Nome",
          "type": "string"
        },
        "obtida_em": {
          "description": "Momento da recolha, sempre com fuso horário.",
          "format": "date-time",
          "title": "Obtida Em",
          "type": "string"
        },
        "url": {
          "description": "Endereço exato de onde os dados foram obtidos.",
          "format": "uri",
