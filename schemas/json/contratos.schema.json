    "LinhaComparacao": {
      "additionalProperties": false,
      "description": "2026 face a um ano de referência, no mesmo dia do ciclo, para uma faixa etária.",
      "properties": {
        "ano_base": {
          "title": "Ano Base",
          "type": "integer"
        },
        "desvio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Votos observados / esperados - 1. Positivo: acima do ritmo do ano de referência.",
          "title": "Desvio"
        },
        "efeito_participacao": {
          "description": "Parte da variação da quota explicada por a faixa votar mais ou menos até este dia.",
          "title": "Efeito Participacao",
          "type": "number"
        },
        "efeito_recenseamento": {
          "description": "Parte da variação da quota explicada por haver mais ou menos recenseados da faixa.",
          "title": "Efeito Recenseamento",
          "type": "number"
        },
        "esperado": {
          "description": "Votos esperados: recenseados de hoje x taxa do ano de referência no mesmo dia.",
          "title": "Esperado",
          "type": "number"
        },
        "faixa": {
          "enum": [
            "18-24",
            "25-29",
            "30-39",
            "40-49",
            "50-64",
            "65-74",
            "75+",
            "desconhecida",
            "total"
          ],
          "title": "Faixa",
          "type": "string"
        },
        "quota": {
          "description": "Quota da faixa no voto antecipado (composição).",
          "title": "Quota",
          "type": "number"
        },
        "quota_base": {
          "title": "Quota Base",
          "type": "number"
        },
        "quota_recenseamento": {
          "description": "Quota da faixa nos eleitores recenseados.",
          "title": "Quota Recenseamento",
          "type": "number"
        },
        "quota_recenseamento_base": {
          "title": "Quota Recenseamento Base",
          "type": "number"
        },
        "registados": {
          "minimum": 0,
          "title": "Registados",
          "type": "integer"
        },
        "registados_base": {
          "minimum": 0,
          "title": "Registados Base",
          "type": "integer"
        },
        "taxa": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Percentagem dos recenseados da faixa que já votou (participação).",
          "title": "Taxa"
        },
        "taxa_base": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Taxa Base"
        },
        "votos": {
          "minimum": 0,
          "title": "Votos",
          "type": "integer"
        },
        "votos_base": {
          "minimum": 0,
          "title": "Votos Base",
          "type": "integer"
        }
      },
      "required": [
        "ano_base",
        "faixa",
        "votos",
        "registados",
        "votos_base",
        "registados_base",
        "quota",
        "quota_base",
        "quota_recenseamento",
        "quota_recenseamento_base",
        "taxa",
        "taxa_base",
        "esperado",
