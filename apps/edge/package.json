{
  "name": "@intercalares/edge",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker: serve o site estático, a API de dados ao vivo e o watchdog.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "validadores:gerar": "node scripts/gerar-validadores.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "hono": "^4.13.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@intercalares/web": "workspace:*",
    "@types/node": "^26.6.5",
    "typescript": "~6.0.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.150.0"
  }
}
