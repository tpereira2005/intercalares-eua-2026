// Configuração do Worker. Não contém segredos: tokens e identificadores de
// conta vivem nos segredos do GitHub e da Cloudflare (ver docs/implantacao.md).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "intercalares-eua-2026",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // O site é o export estático do Next.js. Pedidos a ficheiros estáticos são
  // gratuitos e ilimitados; só /api/* passa pelo código do Worker.
  "assets": {
    "directory": "../web/out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"],
  },

  // Snapshots correntes. Este database_id é um marcador: o workflow de
  // implantação cria a base de dados e escreve o id real (scripts/preparar-d1.mjs).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "intercalares-eua-2026",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],

  // Watchdog: a cada minuto confirma que os workflows de recolha correm.
  "triggers": {
    "crons": ["* * * * *"],
  },

  "vars": {
    "AMBIENTE": "producao",
    // Intervalo (segundos) que /api/ao-vivo sugere aos browsers; limitado a 30-600.
    "INTERVALO_S": "60",
    // Ficheiros servidos por /api/resultados e /api/noite (docs/api-ao-vivo.md). Para um
    // ensaio local: wrangler dev --var URL_PROJECAO_NOITE:<url do ficheiro de 2024>.
    "URL_PARCIAIS": "https://github.com/tpereira2005/intercalares-eua-2026/releases/download/resultados-2026/parciais.json",
    "URL_PROJECAO_NOITE": "https://github.com/tpereira2005/intercalares-eua-2026/releases/download/dados-noite/projecao-noite-2026.json",
    "URL_HISTORICO_NOITE": "https://github.com/tpereira2005/intercalares-eua-2026/releases/download/dados-noite/historico-noite-2026.json",
    "URL_CHAMADAS": "https://github.com/tpereira2005/intercalares-eua-2026/releases/download/resultados-2026/chamadas-2026.json",
  },

  "observability": {
    "enabled": true,
  },
}
